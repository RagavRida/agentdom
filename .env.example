# Environment variables for AgentDOM
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Provider credentials (set any you need) ───────────────────────────────────
# AGENTDOM_OPENROUTER_AI_KEY=sk-or-v1-xxx
# AGENTDOM_RESEND_COM_KEY=re_xxx
# AGENTDOM_LINEAR_APP_KEY=lin_api_xxx
# AGENTDOM_STRIPE_COM_KEY=sk_live_xxx
# AGENTDOM_GITHUB_COM_KEY=ghp_xxx
# AGENTDOM_ANTHROPIC_COM_KEY=sk-ant-xxx
# AGENTDOM_OPENAI_COM_KEY=sk-xxx

# ── Wallet injection (alternative to per-provider keys) ───────────────────────
# Export from: agentdom wallet export --base64
# AGENTDOM_WALLET_B64=eyJ3YWxsZXQiOiIwLjEiLCJwcm92aWRlcnMiOnt9fQ==

# Or point to a wallet file:
# AGENTDOM_WALLET_PATH=/path/to/agent.wallet.json

# ── External secrets vaults (optional) ────────────────────────────────────────
# AWS SSM — AgentDOM will look at /agentdom/<host>/token
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx

# HashiCorp Vault — AgentDOM will look at secret/agentdom/<host>
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=hvs.xxx

# 1Password Secrets Automation — op://AgentDOM/<host>/token
# OP_SERVICE_ACCOUNT_TOKEN=ops_xxx

# ── OpenRouter (for goal-based dispatch) ─────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-xxx

# ── Policy ─────────────────────────────────────────────────────────────────────
# AGENTDOM_POLICY_FILE=/path/to/policy.json
