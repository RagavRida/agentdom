{
  "name": "agentdom",
  "version": "3.1.0",
  "description": "Universal AI agent runtime. Gives agents structured, typed access to any software — web, desktop, CLI. No screenshots needed.",
  "main": "agentdom.js",
  "bin": {
    "agentdom": "./cli.js"
  },
  "files": [
    "agentdom.js",
    "cli.js",
    "mcp-server.js",
    "desktop-mcp-server.js",
    "mcp-cli-server.js",
    "mcp-api-server.js",
    "agent-platform.js",
    "integrations/",
    "desktop-agent/",
    "compiler/",
    "commands/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "cli": "node cli.js",
    "init": "node cli.js init",
    "desktop": "node cli.js --desktop",
    "server": "node integrations/http-server.js",
    "mcp": "node mcp-server.js",
    "mcp:desktop": "node desktop-mcp-server.js",
    "mcp:cli": "node mcp-cli-server.js",
    "mcp:api": "node mcp-api-server.js",
    "a2a": "node integrations/a2a.js",
    "openai": "node integrations/openai.js",
    "gemini": "node integrations/gemini.js",
    "test": "node --test test/*.test.js",
    "test:compiler": "node compiler/__test__.js",
    "build:mac": "npx -y pkg ./cli.js --targets node18-macos-x64,node18-macos-arm64 --out-path dist/",
    "build:win": "npx -y pkg ./cli.js --targets node18-win-x64 --out-path dist/",
    "build:linux": "npx -y pkg ./cli.js --targets node18-linux-x64 --out-path dist/",
    "build:all": "npx -y pkg ./cli.js --targets node18-macos-x64,node18-macos-arm64,node18-win-x64,node18-linux-x64 --out-path dist/"
  },
  "pkg": {
    "assets": ["agentdom.js", "integrations/**/*", "mcp-server.js"],
    "scripts": ["cli.js"]
  },
  "keywords": [
    "ai-agent", "browser-automation", "web-agent", "mcp", "openai", "gemini",
    "function-calling", "autonomous", "a2a", "agent-to-agent", "agentdom",
    "desktop-automation", "ai-native", "schema", "universal-runtime"
  ],
  "author": "AgentDOM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RagavRida/agentdom"
  },
  "homepage": "https://getagentdom.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "uuid": "^11.1.0"
  },
  "optionalDependencies": {
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "engines": {
    "node": ">=18"
  }
}
